{
  "name": "feishu-listener",
  "version": "1.0.0",
  "description": "Feishu WebSocket message listener for POA Master",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop feishu-listener",
    "pm2:restart": "pm2 restart feishu-listener",
    "pm2:logs": "pm2 logs feishu-listener",
    "pm2:status": "pm2 status feishu-listener",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "dependencies": {
    "openai": "^6.22.0",
    "protobufjs": "^7.4.0",
    "undici": "^7.22.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
