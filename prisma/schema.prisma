generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Assignee {
  id             String          @id @default(cuid())
  name           String          @unique
  feishuUserId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  artifacts      Artifact[]
  confirmedItems ConfirmedItem[]
  tasks          Task[]
  objectives     Objective[]
  keyResults     KeyResult[]

  @@index([name])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  dod        String?
  dueDate    DateTime?
  status     TaskStatus @default(TODO)
  assigneeId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  decisionId String?
  assignee   Assignee?  @relation(fields: [assigneeId], references: [id])
  decision   Decision?  @relation(fields: [decisionId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([decisionId])
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Artifact {
  id             String          @id @default(cuid())
  assigneeId     String
  fileName       String
  fileType       String
  filePath       String
  charCount      Int
  pageCount      Int?
  status         String          @default("uploading")
  errorMessage   String?
  modelName      String?
  promptVersion  String?
  latencyMs      Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignee       Assignee        @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  confirmedItems ConfirmedItem[]
  draftItems     DraftItem[]

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
}

model DraftItem {
  id           String   @id @default(cuid())
  artifactId   String
  dimension    String
  sortOrder    Int
  content      String
  evidence     String?
  decisionType String?
  action       String?
  etaText      String?
  isEdited     Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  movedFrom    String?
  mergedFrom   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  artifact     Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([dimension])
}

model ConfirmedItem {
  id           String   @id @default(cuid())
  assigneeId   String
  artifactId   String
  dimension    String
  sortOrder    Int
  content      String
  decisionType String?
  action       String?
  etaText      String?
  status       String   @default("active")
  smartFlags   Json?
  pushedToTodo Boolean  @default(false)
  todoTaskId   String?
  pushError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  artifact     Artifact @relation(fields: [artifactId], references: [id])
  assignee     Assignee @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([dimension])
  @@index([status])
  @@index([createdAt])
  @@index([pushedToTodo])
}

model PulseProject {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  entries   PulseEntry[]
  reports   PulseReport[]

  @@index([updatedAt])
}

model PulseReport {
  id          String                 @id @default(cuid())
  projectId   String
  fileName    String
  filePath    String
  reportType  ReportType
  reportDate  DateTime
  parsedText  String?
  parseStatus ParseStatus            @default(PENDING)
  parseError  String?
  uploadedAt  DateTime               @default(now())
  sessions    PulseAnalysisSession[]
  project     PulseProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PulseAnalysisSession {
  id          String        @id @default(cuid())
  reportId    String
  aiOutputRaw Json
  status      SessionStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  report      PulseReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model PulseEntry {
  id              String         @id @default(cuid())
  projectId       String
  dimension       EntryDimension
  title           String
  evidenceCurrent String
  sourceCurrent   Json
  evidenceHistory Json           @default("[]")
  embedding       Float[]
  deletedAt       DateTime?
  deleteToken     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         PulseProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dimension])
  @@index([deletedAt])
}

model RoundtableTemplate {
  id                 String                 @id @default(cuid())
  name               String
  description        String
  scenario           String?
  enabled            Boolean                @default(true)
  usageCount         Int                    @default(0)
  keywords           Json                   @default("[]")
  priority           Int                    @default(0)
  enabledRounds      Json                   @default("[\"clarify\", \"question\", \"rebuttal\", \"verdict\"]")
  riskChecklist      Json                   @default("[]")
  outputRequirements Json                   @default("{}")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  discussions        RoundtableDiscussion[]
  roles              RoundtableRole[]

  @@index([enabled])
  @@index([priority])
}

model RoundtableRole {
  id             String             @id @default(cuid())
  templateId     String
  name           String
  responsibility String
  focusAreas     String
  order          Int
  createdAt      DateTime           @default(now())
  template       RoundtableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([order])
}

model RoundtableDiscussion {
  id                    String                 @id @default(cuid())
  userId                String
  templateId            String
  title                 String
  materialText          String
  status                String                 @default("processing")
  errorMessage          String?
  conclusion            String?
  conclusionType        String?
  decisionReasoning     String?
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  model                 String?
  actions               RoundtableAction[]
  assumptions           RoundtableAssumption[]
  attachments           RoundtableAttachment[]
  template              RoundtableTemplate     @relation(fields: [templateId], references: [id])
  risks                 RoundtableRisk[]
  rounds                RoundtableRound[]

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model RoundtableRound {
  id           String               @id @default(cuid())
  discussionId String
  roundNumber  Int
  roundType    String
  createdAt    DateTime             @default(now())
  messages     RoundtableMessage[]
  discussion   RoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([roundNumber])
}

model RoundtableMessage {
  id        String          @id @default(cuid())
  roundId   String
  roleName  String
  content   String
  order     Int
  createdAt DateTime        @default(now())
  round     RoundtableRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([order])
}

model RoundtableAction {
  id                 String               @id @default(cuid())
  discussionId       String
  content            String
  assignee           String?
  deadline           DateTime?
  acceptanceCriteria String?
  priority           String               @default("medium")
  taskId             String?
  createdAt          DateTime             @default(now())
  discussion         RoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([priority])
}

model RoundtableRisk {
  id           String               @id @default(cuid())
  discussionId String
  description  String
  impact       String
  mitigation   String?
  priority     String               @default("medium")
  riskType     String?
  createdAt    DateTime             @default(now())
  discussion   RoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([priority])
}

model RoundtableAttachment {
  id           String               @id @default(cuid())
  discussionId String
  filename     String
  filepath     String
  filetype     String
  filesize     Int
  createdAt    DateTime             @default(now())
  discussion   RoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

model RoundtableAssumption {
  id           String               @id @default(cuid())
  discussionId String
  description  String
  confidence   String
  reasoning    String
  createdAt    DateTime             @default(now())
  discussion   RoundtableDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

model FeishuChat {
  id            String          @id @default(cuid())
  chatId        String          @unique
  chatType      String
  name          String?
  avatar        String?
  memberCount   Int?
  lastMessage   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isBlacklisted Boolean         @default(false)
  blacklistedAt DateTime?
  isWhitelisted   Boolean  @default(false)
  whitelistedAt   DateTime?
  isRenamed     Boolean         @default(false)
  digests       ChatDigest[]
  signals       ChatSignal[]
  messages      FeishuMessage[]
  pulses        TeamPulse[]

  @@index([chatType])
  @@index([lastMessage])
}

model FeishuMessage {
  id         String     @id @default(cuid())
  messageId  String     @unique
  chatId     String
  senderId   String
  senderName String
  content    String
  msgType    String
  rawData    String?
  timestamp  DateTime
  createdAt  DateTime   @default(now())
  chat       FeishuChat @relation(fields: [chatId], references: [chatId])

  @@index([chatId])
  @@index([timestamp])
  @@index([senderId])
}

model ChatSignal {
  id          String     @id @default(cuid())
  chatId      String
  signalType  String
  severity    String     @default("MEDIUM")
  title       String
  summary     String
  messageIds  String[]
  relatedUser String?
  isResolved  Boolean    @default(false)
  resolvedAt  DateTime?
  source      String     @default("batch")
  detectedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  chat        FeishuChat @relation(fields: [chatId], references: [chatId])

  @@index([chatId])
  @@index([signalType])
  @@index([detectedAt])
  @@index([isResolved])
}

model ChatDigest {
  id           String     @id @default(cuid())
  chatId       String
  date         DateTime   @db.Date
  summary      String
  keyTopics    String[]
  messageCount Int
  activeUsers  String[]
  signalCount  Json?
  createdAt    DateTime   @default(now())
  chat         FeishuChat @relation(fields: [chatId], references: [chatId])

  @@unique([chatId, date])
  @@index([date])
}

model TeamPulse {
  id              String     @id @default(cuid())
  chatId          String
  date            DateTime   @db.Date
  messageCount    Int        @default(0)
  activeUserCount Int        @default(0)
  sentimentScore  Float?
  avgResponseTime Float?
  peakHour        Int?
  createdAt       DateTime   @default(now())
  chat            FeishuChat @relation(fields: [chatId], references: [chatId])

  @@unique([chatId, date])
  @@index([date])
}

model InsightTopic {
  id        String         @id @default(cuid())
  name      String
  keywords  String[]       @default([])
  source    String         @default("auto")
  weight    Int            @default(50)
  isPaused  Boolean        @default(false)
  lastHitAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cards     InsightCard[]
  combos    KeywordCombo[]
}

model KeywordCombo {
  id         String        @id @default(cuid())
  topicId    String
  keywords   String[]
  score      Int           @default(50)
  status     String        @default("active")
  usedCount  Int           @default(0)
  lastUsedAt DateTime?
  feedback   Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  cards      InsightCard[]
  topic      InsightTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([status, score])
}

model InsightBriefing {
  id              String           @id @default(cuid())
  date            DateTime         @unique
  summary         String
  status          String           @default("generating")
  feishuSent      Boolean          @default(false)
  cardCount       Int              @default(0)
  createdAt       DateTime         @default(now())
  cards           InsightCard[]
  suggestedTopics SuggestedTopic[]
}

model SuggestedTopic {
  id         String           @id @default(cuid())
  briefingId String?
  name       String
  reason     String
  status     String           @default("pending")
  createdAt  DateTime         @default(now())
  source     String           @default("briefing")
  briefing   InsightBriefing? @relation(fields: [briefingId], references: [id])

  @@index([briefingId])
}

model InsightCard {
  id          String          @id @default(cuid())
  briefingId  String
  topicId     String?
  category    String
  priority    String          @default("medium")
  title       String
  summary     String
  details     String
  impact      String?
  action      String?
  sources     Json            @default("[]")
  relatedData Json            @default("{}")
  feedback    Int?
  viewedAt    DateTime?
  createdAt   DateTime        @default(now())
  comboId     String?
  briefing    InsightBriefing @relation(fields: [briefingId], references: [id])
  combo       KeywordCombo?   @relation(fields: [comboId], references: [id])
  topic       InsightTopic?   @relation(fields: [topicId], references: [id])

  @@index([briefingId])
  @@index([topicId])
  @@index([comboId])
}

model MonitoredGame {
  id           String               @id @default(cuid())
  name         String
  appStoreId   String?
  googlePlayId String?
  xKeywords    String[]             @default([])
  fbKeywords   String[]             @default([])
  iconUrl      String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  alerts       SentimentAlert[]
  dailyStats   SentimentDailyStat[]
  mentions     SentimentMention[]
  reviews      SentimentReview[]
}

model SentimentReview {
  id             String        @id @default(cuid())
  gameId         String
  platform       String
  externalId     String
  author         String?
  rating         Int
  title          String?
  content        String
  language       String?
  sentimentScore Float?
  sentimentLabel String?
  keyIssues      String[]      @default([])
  publishedAt    DateTime
  collectedAt    DateTime      @default(now())
  game           MonitoredGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([gameId, publishedAt])
  @@index([sentimentLabel])
}

model SentimentMention {
  id              String        @id @default(cuid())
  gameId          String
  platform        String
  externalId      String
  author          String?
  authorFollowers Int?
  content         String
  url             String?
  sentimentScore  Float?
  sentimentLabel  String?
  keyIssues       String[]      @default([])
  engagement      Json?
  publishedAt     DateTime
  collectedAt     DateTime      @default(now())
  game            MonitoredGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([gameId, publishedAt])
  @@index([sentimentLabel])
}

model SentimentAlert {
  id         String        @id @default(cuid())
  gameId     String
  type       String
  severity   String
  title      String
  summary    String
  dataPoints Json?
  isRead     Boolean       @default(false)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())
  game       MonitoredGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([isRead])
}

model SentimentDailyStat {
  id            String        @id @default(cuid())
  gameId        String
  date          DateTime      @db.Date
  reviewCount   Int           @default(0)
  mentionCount  Int           @default(0)
  avgSentiment  Float?
  avgRating     Float?
  negativeCount Int           @default(0)
  positiveCount Int           @default(0)
  topIssues     Json?
  summary       String?
  generatedAt   DateTime      @default(now())
  game          MonitoredGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, date])
}

model Decision {
  id         String         @id @default(cuid())
  title      String
  context    String?
  outcome    String?
  status     DecisionStatus @default(PENDING)
  madeAt     DateTime
  madeBy     String?
  reviewDate DateTime?
  notes      String?
  signalId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tasks      Task[]

  @@index([status])
  @@index([madeAt])
  @@index([reviewDate])
}

model BotConversation {
  id              String       @id @default(cuid())
  chatId          String       @unique
  messages        Json         @default("[]")
  lastActiveAt    DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  title           String?
  source          String       @default("feishu")
  claudeSessionId String?
  hasUnread       Boolean      @default(false)
  botMessages     BotMessage[]

  @@index([lastActiveAt])
  @@index([source])
}

model BotMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String          // 'user' | 'assistant'
  content        String?         // null while processing, filled on completion
  status         String          @default("pending") // pending | processing | done | error
  progress       String?         // current progress description
  errorMessage   String?         // error details when status = error
  unread         Boolean         @default(false) // true for new assistant replies
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([updatedAt])
}

model Competitor {
  id           String                  @id @default(cuid())
  name         String
  company      String?
  appStoreId   String?
  googlePlayId String?
  websiteUrl   String?
  monitorUrls  Json                    @default("[]")
  rssFeeds     Json                    @default("[]")
  keywords     Json                    @default("[]")
  enabled      Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  appSnapshots CompetitorAppSnapshot[]
  reviews      CompetitorReview[]
  webChanges   CompetitorWebChange[]
  news         CompetitorNews[]
  alerts       CompetitorAlert[]

  @@index([enabled])
}

model CompetitorAppSnapshot {
  id           String     @id @default(cuid())
  competitorId String
  platform     String
  rating       Float?
  ratingCount  Int?
  version      String?
  releaseNotes String?
  snapshotData Json?
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
}

model CompetitorReview {
  id           String     @id @default(cuid())
  competitorId String
  platform     String
  externalId   String
  author       String?
  rating       Int
  title        String?
  content      String
  sentiment    Float?
  tags         Json?
  reviewDate   DateTime
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([competitorId, reviewDate])
}

model CompetitorWebChange {
  id           String     @id @default(cuid())
  competitorId String
  url          String
  changeType   String
  summary      String?
  diffText     String?
  previousHash String?
  currentHash  String?
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
}

model CompetitorNews {
  id           String      @id @default(cuid())
  competitorId String?
  title        String
  url          String      @unique
  source       String
  summary      String?
  impact       String?
  category     String?
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@index([competitorId, createdAt])
}

model CompetitorAlert {
  id           String     @id @default(cuid())
  competitorId String
  alertType    String
  severity     String
  title        String
  summary      String
  acknowledged Boolean    @default(false)
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
  @@index([acknowledged])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
  POSTPONED
}

enum ReportType {
  DAILY
  WEEKLY
  OTHER
}

enum ParseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SessionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntryDimension {
  OVERALL_HEALTH
  SCHEDULE
  SCOPE
  RISKS
  BLOCKERS
  DEPENDENCIES
  QUALITY
  RESOURCING
  DECISIONS
  KPI
  PLAN_CREDIBILITY
  ALIGNMENT
}

enum DecisionStatus {
  PENDING
  EXECUTING
  COMPLETED
  REVISED
}

model AlertRule {
  id         String   @id @default(cuid())
  keyword    String
  signalType String
  severity   String   @default("MEDIUM")
  isSystem   Boolean  @default(false)
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isEnabled])
  @@index([signalType])
}

model AlertSenderWhitelist {
  id         String   @id @default(cuid())
  senderId   String   @unique
  senderName String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([senderId])
}

enum OkrPeriodType {
  QUARTERLY
  MONTHLY
  ANNUAL
}

enum OkrStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Objective {
  id          String        @id @default(cuid())
  title       String
  description String?
  periodType  OkrPeriodType @default(QUARTERLY)
  periodLabel String
  status      OkrStatus     @default(ACTIVE)
  weight      Float         @default(1.0)
  ownerId     String?
  parentId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       Assignee?     @relation(fields: [ownerId], references: [id])
  parent      Objective?    @relation("ObjectiveHierarchy", fields: [parentId], references: [id])
  children    Objective[]   @relation("ObjectiveHierarchy")
  keyResults  KeyResult[]

  @@index([ownerId])
  @@index([status])
  @@index([periodLabel])
}

model KeyResult {
  id           String    @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String    @default("%")
  weight       Float     @default(1.0)
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner        Assignee? @relation(fields: [ownerId], references: [id])

  @@index([objectiveId])
  @@index([ownerId])
}
